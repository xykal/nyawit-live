<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('android-'))">net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('android-'))">24.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
</Project>
